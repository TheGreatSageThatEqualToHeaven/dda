-- Root ScreenGui was initialized at top level to ensure global scope across all helper functions.

UserInputService.InputBegan:Connect(function(inp)
	if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
		if activeDropdownMenu then
			local mousePos = inp.Position
			local mPos = activeDropdownMenu.AbsolutePosition
			local mSize = activeDropdownMenu.AbsoluteSize
			local inMenu = (mousePos.X >= mPos.X - 2 and mousePos.X <= mPos.X + mSize.X + 2
				and mousePos.Y >= mPos.Y - 2 and mousePos.Y <= mPos.Y + mSize.Y + 2)
			
			local inTrigger = false
			if activeDropdownTrigger then
				local tPos = activeDropdownTrigger.AbsolutePosition
				local tSize = activeDropdownTrigger.AbsoluteSize
				inTrigger = (mousePos.X >= tPos.X - 2 and mousePos.X <= tPos.X + tSize.X + 2
					and mousePos.Y >= tPos.Y - 2 and mousePos.Y <= tPos.Y + tSize.Y + 2)
			end

			-- Only close when clicking outside both the dropdown menu AND the trigger
			if not inMenu and not inTrigger then
				task.defer(closeActiveDropdown)
			end
		end
	end
end)

-- Auto-close dropdown only when mouse wheel is scrolled OUTSIDE the dropdown menu
UserInputService.InputChanged:Connect(function(inp)
	if activeDropdownMenu and inp.UserInputType == Enum.UserInputType.MouseWheel then
		local mousePos = UserInputService:GetMouseLocation()
		local mPos = activeDropdownMenu.AbsolutePosition
		local mSize = activeDropdownMenu.AbsoluteSize
		local inMenu = (mousePos.X >= mPos.X and mousePos.X <= mPos.X + mSize.X
			and mousePos.Y >= mPos.Y and mousePos.Y <= mPos.Y + mSize.Y)
		if not inMenu then
			closeActiveDropdown()
		end
	end
end)

