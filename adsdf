	local fpsConn = RunService.RenderStepped:Connect(function()
		frameCount += 1
		local now = os.clock()
		if now - lastFpsUpdate >= 0.5 then
			liveFps = math.round(frameCount / (now - lastFpsUpdate))
			frameCount = 0
			lastFpsUpdate = now
		end
	end)
	task.spawn(function()
		while gui and gui.Parent do
			if homePage and homePage.Visible then pcall(updateHomeStats) end
			task.wait(0.5)
		end
		if fpsConn then fpsConn:Disconnect() end
	end)
end -- End of Home Page scope

