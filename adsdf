		end
	end

	local names = listNamedConfigs()
	if settingsCategoryButtons["Profiles"] and settingsCategoryButtons["Profiles"].badge then
		settingsCategoryButtons["Profiles"].badge.Text = tostring(#names)
	end
	if settingsCategoryButtons["Themes"] and settingsCategoryButtons["Themes"].badge then
		settingsCategoryButtons["Themes"].badge.Text = "6"
	end
	if settingsCategoryButtons["Interface"] and settingsCategoryButtons["Interface"].badge then
		settingsCategoryButtons["Interface"].badge.Text = "4"
	end
	if settingsCategoryButtons["General"] and settingsCategoryButtons["General"].badge then
		settingsCategoryButtons["General"].badge.Text = "2"
	end

	if selectedSettingsCategory == "Profiles" then
		settingsActionBox.Visible = true
		configList.Position = UDim2.fromOffset(28, 92)
		configList.Size = UDim2.new(1, -56, 1, -112)

