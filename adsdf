	local btn = Instance.new("TextButton")
	btn.Name = "ActionButton_" .. text
	btn.AutoButtonColor = false
	btn.Size = UDim2.new(1, 0, 0, 36)
	btn.BorderSizePixel = 0
	btn.Parent = parent
	addCorner(btn, 6)

	local baseBg: Color3
	local hoverBg: Color3
	local baseFg: Color3
	local strokeColor: Color3

	if variant == "primary" then
		baseBg = THEME.primary
		hoverBg = THEME.accentHover
		baseFg = THEME.bgWindow
		strokeColor = THEME.primary
	elseif variant == "brand" then
		baseBg = THEME.brandTeal
		hoverBg = THEME.accentHover
		baseFg = Color3.fromRGB(255, 255, 255)
		strokeColor = THEME.brandTeal
	else
		baseBg = THEME.panelRaised
		hoverBg = THEME.accent
		baseFg = THEME.textPrimary
		strokeColor = THEME.borderSubtle
	end

	btn.BackgroundColor3 = baseBg
	local btnStroke = addStroke(btn, strokeColor, 1, 0.4)

	local iconOffset = 0
	if iconName and ICONS[iconName] then
		iconOffset = 22
		local icon = createIcon(btn, iconName, 16, baseFg)
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Position = UDim2.new(0, 12, 0.5, 0)
	end

	local lbl = Instance.new("TextLabel")
	lbl.Name = "ButtonText"
	lbl.Size = UDim2.new(1, -(iconOffset + 24), 1, 0)
	lbl.Position = UDim2.fromOffset(12 + iconOffset, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = baseFg
	lbl.TextSize = 12
	lbl.Font = Enum.Font.GothamBold
	lbl.TextXAlignment = (iconOffset > 0) and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
	lbl.Parent = btn

	local isAccentVariant = (variant == "primary" or variant == "brand")

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = isAccentVariant and THEME.accentHover or hoverBg }):Play()
	end)

	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = isAccentVariant and THEME.primary or baseBg }):Play()
	end)

	btn.MouseButton1Down:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.08), { Size = UDim2.new(1, -4, 0, 34) }):Play()
	end)

	btn.MouseButton1Up:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 36) }):Play()
	end)

	btn.Activated:Connect(function()
		if onClick then onClick() end
	end)

	return btn
end

-- Shared Floating Dropdown Overlay (prevents clipping by ScrollingFrame or row containers)
local activeDropdownMenu: Frame? = nil
local activeDropdownTrigger: GuiObject? = nil
local activeDropdownCleanup: (() -> ())? = nil
local activeDropdownRenderConn: RBXScriptConnection? = nil
local lastDropdownToggleTime = 0

local disabledScrollingFrames: {ScrollingFrame} = {}

local function unlockScrolling()
	for _, sf in ipairs(disabledScrollingFrames) do
		if sf and sf.Parent then
			sf.ScrollingEnabled = true
		end
	end
	table.clear(disabledScrollingFrames)
end

local function lockScrolling()
	table.clear(disabledScrollingFrames)
	-- Active overlay absorbs pointer and wheel input directly without costly tree traversal
end

local function closeActiveDropdown()
	if activeDropdownRenderConn then
		activeDropdownRenderConn:Disconnect()
		activeDropdownRenderConn = nil
	end
	if activeDropdownCleanup then
		activeDropdownCleanup()
		activeDropdownCleanup = nil
	end
	if activeDropdownMenu then
		activeDropdownMenu:Destroy()
		activeDropdownMenu = nil
	end
	activeDropdownTrigger = nil
	unlockScrolling()
end

-- Reusable Interactive Slider Component
local function createSlider(parent: Instance, config: {
	name: string?,
	min: number?,
	max: number?,
	default: number?,
	step: number?,
	unit: string?,
	size: UDim2?,
	callback: ((number) -> ())?
})
	local minVal = config.min or 0
	local maxVal = config.max or 100
	local step = config.step or 1
	local unit = config.unit or ""
	local currentVal = math.clamp(config.default or minVal, minVal, maxVal)

	local container = Instance.new("Frame")
	container.Name = "Slider_" .. (config.name or "Component")
	container.Size = config.size or UDim2.new(1, 0, 0, 32)
	container.BackgroundTransparency = 1
	container.Parent = parent

	-- Value readout pill
	local valPill = Instance.new("Frame")
	valPill.Name = "ValuePill"
	valPill.AnchorPoint = Vector2.new(1, 0.5)
	valPill.Position = UDim2.new(1, 0, 0.5, 0)
	valPill.Size = UDim2.fromOffset(46, 24)
	valPill.BackgroundColor3 = THEME.panelRaised
	valPill.BorderSizePixel = 0
	valPill.ZIndex = 5
	valPill.Parent = container
	addCorner(valPill, 4)
	addStroke(valPill, THEME.borderSubtle, 1, 0.3)

	local valLabel = Instance.new("TextLabel")
	valLabel.Name = "ValueText"
	valLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	valLabel.Position = UDim2.fromScale(0.5, 0.5)
	valLabel.Size = UDim2.fromScale(1, 1)
	valLabel.BackgroundTransparency = 1
	valLabel.Text = tostring(currentVal) .. unit
	valLabel.TextColor3 = THEME.brandTeal
	valLabel.TextSize = 11
	valLabel.Font = Enum.Font.GothamBold
	valLabel.TextXAlignment = Enum.TextXAlignment.Center
	valLabel.TextYAlignment = Enum.TextYAlignment.Center
	valLabel.ZIndex = 6
	valLabel.Parent = valPill

	-- Slider bar track
	local track = Instance.new("TextButton")
	track.Name = "Track"
	track.AutoButtonColor = false
	track.Text = ""
	track.AnchorPoint = Vector2.new(0, 0.5)
	track.Position = UDim2.new(0, 0, 0.5, 0)
	track.Size = UDim2.new(1, -54, 0, 6)
	track.BackgroundColor3 = THEME.accent
	track.BorderSizePixel = 0
	track.ZIndex = 5
	track.Parent = container
	addCorner(track, 3)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(math.clamp((currentVal - minVal) / math.max(1, maxVal - minVal), 0, 1), 1)
	fill.BackgroundColor3 = THEME.primary
	fill.BorderSizePixel = 0
	fill.ZIndex = 6
	fill.Parent = track
	addCorner(fill, 3)

	local thumb = Instance.new("Frame")
	thumb.Name = "Thumb"
	thumb.AnchorPoint = Vector2.new(0.5, 0.5)
	thumb.Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, 0)
	thumb.Size = UDim2.fromOffset(14, 14)
	thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	thumb.BorderSizePixel = 0
	thumb.ZIndex = 7
	thumb.Parent = track
	addCorner(thumb, 7)
	addStroke(thumb, Color3.fromRGB(0, 0, 0), 1, 0.5)

	local dragging = false

	local function setValue(newVal: number)
		local clamped = math.clamp(newVal, minVal, maxVal)
		if step > 0 then
			clamped = math.round((clamped - minVal) / step) * step + minVal
			clamped = math.clamp(clamped, minVal, maxVal)
		end
		currentVal = clamped
		local pct = math.clamp((currentVal - minVal) / math.max(1, maxVal - minVal), 0, 1)
		fill.Size = UDim2.fromScale(pct, 1)
		thumb.Position = UDim2.new(pct, 0, 0.5, 0)
		valLabel.Text = tostring(currentVal) .. unit
		if config.callback then
			config.callback(currentVal)
		end
	end

	local function updateFromInput(inputX: number)
		local absX = track.AbsolutePosition.X
		local absW = track.AbsoluteSize.X
		if absW <= 0 then return end
		local rel = math.clamp((inputX - absX) / absW, 0, 1)
		setValue(minVal + rel * (maxVal - minVal))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input.Position.X)
		end
	end)

	local moveConn: RBXScriptConnection? = nil
	local releaseConn: RBXScriptConnection? = nil

	moveConn = UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input.Position.X)
		end
	end)

	releaseConn = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	container.Destroying:Connect(function()
		if moveConn then moveConn:Disconnect() end
		if releaseConn then releaseConn:Disconnect() end
	end)

	return container, {
		Set = setValue,
		Get = function() return currentVal end,
	}
end

