	bVape.Size = UDim2.fromScale(1, 1)
	bVape.TextXAlignment = Enum.TextXAlignment.Center
	bVape.ZIndex = 3

	-- Loading progress track (.load-track)
	local track = Instance.new("Frame")
	track.AnchorPoint = Vector2.new(0.5, 0.5)
	track.Position = UDim2.fromScale(0.5, 0.57)
	track.Size = UDim2.fromOffset(310, 5)
	track.BackgroundColor3 = Color3.fromRGB(8, 8, 10)
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.ZIndex = 3
	track.Parent = modal
