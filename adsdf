	local sLayout = Instance.new("UIListLayout")
	sLayout.Padding = UDim.new(0, 10)
	sLayout.Parent = settingsScroll

	local settingRows = { "Teams by server", "Teams by color", "NPC filter" }
	for i, sName in ipairs(settingRows) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 42)
		row.BackgroundColor3 = THEME.panelRaised
		row.BorderSizePixel = 0
		row.Parent = settingsScroll
		addCorner(row, 6)

		local lbl = createLabel(row, sName, 13, THEME.textPrimary, Enum.Font.Gotham)
		lbl.Position = UDim2.fromOffset(14, 0)
		lbl.Size = UDim2.new(1, -70, 1, 0)

		local tHolder = Instance.new("Frame")
		tHolder.AnchorPoint = Vector2.new(1, 0.5)
		tHolder.Position = UDim2.new(1, -10, 0.5, 0)
		tHolder.Size = UDim2.fromOffset(36, 22)
		tHolder.BackgroundTransparency = 1
		tHolder.Parent = row

		createToggle(tHolder, (i == 3 and enabledState[item.name]) or false, function(val)
			if i == 3 then
				enabledState[item.name] = val
				badge.Text = val and "ON" or "OFF"
				badge.BackgroundColor3 = val and THEME.primary or THEME.accent
				badge.TextColor3 = val and THEME.bgWindow or THEME.textMuted
				local fn = item.onToggle or item.callback
				if fn then safeCall(fn, val) end
				if refreshModules then refreshModules() end
			end
		end)
	end

	-- Smoothness Interactive Slider (72% default)
	local sliderCard = Instance.new("Frame")
	sliderCard.Size = UDim2.new(1, 0, 0, 72)
	sliderCard.BackgroundColor3 = THEME.panelRaised
	sliderCard.BorderSizePixel = 0
	sliderCard.Parent = settingsScroll
	addCorner(sliderCard, 6)

	local sTitle = createLabel(sliderCard, "Smoothness", 13, THEME.textPrimary, Enum.Font.Gotham)
	sTitle.Position = UDim2.fromOffset(14, 10)
	sTitle.Size = UDim2.fromOffset(120, 18)

	local sVal = createLabel(sliderCard, "72", 13, THEME.brandTeal, Enum.Font.GothamBold)
	sVal.AnchorPoint = Vector2.new(1, 0)
	sVal.Position = UDim2.new(1, -14, 0, 10)
	sVal.Size = UDim2.fromOffset(40, 18)
	sVal.TextXAlignment = Enum.TextXAlignment.Right

	local bar = Instance.new("TextButton")
	bar.AutoButtonColor = false
	bar.Text = ""
	bar.Position = UDim2.fromOffset(14, 44)
	bar.Size = UDim2.new(1, -28, 0, 6)
	bar.BackgroundColor3 = THEME.accent
	bar.BorderSizePixel = 0
	bar.Parent = sliderCard
	addCorner(bar, 3)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0.72, 1)
	fill.BackgroundColor3 = THEME.brandTeal
	fill.BorderSizePixel = 0
	fill.Parent = bar
	addCorner(fill, 3)

	local thumb = Instance.new("Frame")
	thumb.AnchorPoint = Vector2.new(0.5, 0.5)
	thumb.Position = UDim2.new(0.72, 0, 0.5, 0)
	thumb.Size = UDim2.fromOffset(14, 14)
	thumb.BackgroundColor3 = THEME.textPrimary
	thumb.BorderSizePixel = 0
	thumb.Parent = bar
	addCorner(thumb, 7)

	local draggingSlider = false
	local function updateSlider(xPos: number)
		local absPos = bar.AbsolutePosition.X
		local absSize = bar.AbsoluteSize.X
		local rel = math.clamp((xPos - absPos) / absSize, 0, 1)
		local intVal = math.round(rel * 100)
		sVal.Text = tostring(intVal)
		fill.Size = UDim2.fromScale(rel, 1)
		thumb.Position = UDim2.new(rel, 0, 0.5, 0)
	end

	bar.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = true
			updateSlider(inp.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			draggingSlider = false
		end
	end)

	UserInputService.InputChanged:Connect(function(inp)
		if draggingSlider and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			updateSlider(inp.Position.X)
		end
	end)

	-- Single-Select Mode Dropdown
	local modeCard = Instance.new("Frame")
	modeCard.Size = UDim2.new(1, 0, 0, 44)
	modeCard.BackgroundColor3 = THEME.panelRaised
	modeCard.BorderSizePixel = 0
	modeCard.Parent = settingsScroll
	addCorner(modeCard, 6)

	local mLabel = createLabel(modeCard, "Mode", 13, THEME.textPrimary, Enum.Font.Gotham)
	mLabel.Position = UDim2.fromOffset(14, 0)
	mLabel.Size = UDim2.fromOffset(80, 44)

	local modeDropHolder = Instance.new("Frame")
	modeDropHolder.AnchorPoint = Vector2.new(1, 0.5)
	modeDropHolder.Position = UDim2.new(1, -10, 0.5, 0)
	modeDropHolder.Size = UDim2.fromOffset(130, 28)
	modeDropHolder.BackgroundTransparency = 1
	modeDropHolder.Parent = modeCard

	createDropdown(modeDropHolder, {
		name = "DrawerMode",
		options = { "Balanced", "Legit", "Aggressive" },
		default = "Balanced",
		size = UDim2.fromScale(1, 1),
	})

	drawer.Visible = true
	drawer.Position = UDim2.fromScale(1, 0)
	if refreshModules then refreshModules() end
end

