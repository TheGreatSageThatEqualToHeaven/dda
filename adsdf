	panelBorder    = Color3.fromRGB(55, 56, 60),       -- loader window border
	accent         = Color3.fromRGB(35, 36, 40),       -- var(--accent): #232428
	border         = Color3.fromRGB(55, 56, 60),       -- var(--border): #37383c
	borderSubtle   = Color3.fromRGB(38, 39, 44),       -- inset row border
	textPrimary    = Color3.fromRGB(240, 242, 244),   -- var(--foreground): #f0f2f4
	textSecondary  = Color3.fromRGB(169, 171, 176),   -- var(--secondary-foreground): #a9abb0
	secondaryFg   = Color3.fromRGB(169, 171, 176),   -- keyboard bind text
	textMuted      = Color3.fromRGB(120, 122, 128),   -- var(--muted-foreground): #787a80
	brandTeal      = ACCENT,                          -- unified accent
	warmAmber      = ACCENT,                          -- unified accent (was orange)
	toggleOffTrack = Color3.fromRGB(35, 36, 40),       -- var(--accent)
	toggleOffKnob  = Color3.fromRGB(120, 122, 128),   -- var(--muted-foreground)
	primary        = ACCENT,                          -- unified accent: active controls and tab underline
	toggleOnTrack  = ACCENT,                          -- unified accent
	toggleOnKnob   = Color3.fromRGB(255, 255, 255),   -- white knob, same as slider thumb
	accentHover    = ACCENT:Lerp(Color3.fromRGB(255, 255, 255), 0.18),
}

local accentListeners = {}
local function onAccentChange(fn: (Color3) -> ())
	table.insert(accentListeners, fn)
	pcall(fn, THEME.warmAmber)
end

local activeSelectedAccent = ACCENT
local updateCursorAccent: ((Color3, number?) -> ())? = nil

local function sameColor(a: Color3, b: Color3, tolerance: number?): boolean
	if not a or not b then return false end
	local tol = tolerance or 4
	return math.abs(math.round(a.R * 255) - math.round(b.R * 255)) <= tol
		and math.abs(math.round(a.G * 255) - math.round(b.G * 255)) <= tol
		and math.abs(math.round(a.B * 255) - math.round(b.B * 255)) <= tol
end

local ACCENT_PROPS = { "BackgroundColor3", "TextColor3", "ImageColor3", "PlaceholderColor3", "ScrollBarImageColor3", "TextStrokeColor3" }

-- Walks the whole interface and smoothly transitions any color matching the previous accent
-- (or its hover tint) to the new one with fluid easing.
local function repaintAccent(oldAccent: Color3, newAccent: Color3, oldHover: Color3, newHover: Color3, oldKnob: Color3, newKnob: Color3, duration: number?)
	local dur = duration or 0.35
	local tweenInfo = dur > 0 and TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) or nil

	for _, obj in ipairs(gui:GetDescendants()) do
		-- Theme swatches always show their own color and are never repainted.
		local fixed = obj:GetAttribute("FixedColor") == true
			or (obj.Parent ~= nil and obj.Parent:GetAttribute("FixedColor") == true)
		if fixed then
			continue
		elseif obj:IsA("UIStroke") then
			local role = obj:GetAttribute("AccentRole")
			if sameColor(obj.Color, oldAccent) or role == "primary" then
				obj:SetAttribute("AccentRole", "primary")
				if tweenInfo then
					TweenService:Create(obj, tweenInfo, { Color = newAccent }):Play()
				else
					obj.Color = newAccent
				end
			elseif sameColor(obj.Color, oldHover) or role == "hover" then
				obj:SetAttribute("AccentRole", "hover")
				if tweenInfo then
					TweenService:Create(obj, tweenInfo, { Color = newHover }):Play()
				else
					obj.Color = newHover
				end
			end
		elseif obj:IsA("GuiObject") then
			if obj.Name == "Knob" and obj.Parent and obj.Parent.Name == "ToggleTrack" then
				if (sameColor(obj.BackgroundColor3, oldKnob) or obj:GetAttribute("AccentRole") == "knob")
					and obj.Parent.BackgroundColor3
					and (sameColor(obj.Parent.BackgroundColor3, oldAccent) or obj.Parent:GetAttribute("AccentProp_BackgroundColor3") == "primary") then
					obj:SetAttribute("AccentRole", "knob")
					if tweenInfo then
						TweenService:Create(obj, tweenInfo, { BackgroundColor3 = newKnob }):Play()
					else
						obj.BackgroundColor3 = newKnob
					end
				end
			end
			for _, prop in ipairs(ACCENT_PROPS) do
				local ok, value = pcall(function() return (obj :: any)[prop] end)
				if ok and typeof(value) == "Color3" then
					local attrName = "AccentProp_" .. prop
					local role = obj:GetAttribute(attrName)
					if sameColor(value, oldAccent) or role == "primary" then
						obj:SetAttribute(attrName, "primary")
						if tweenInfo then
							pcall(function()
								TweenService:Create(obj, tweenInfo, { [prop] = newAccent }):Play()
							end)
						else
							pcall(function() (obj :: any)[prop] = newAccent end)
						end
					elseif sameColor(value, oldHover) or role == "hover" then
						obj:SetAttribute(attrName, "hover")
						if tweenInfo then
							pcall(function()
								TweenService:Create(obj, tweenInfo, { [prop] = newHover }):Play()
							end)
						else
							pcall(function() (obj :: any)[prop] = newHover end)
						end
					end
				end
			end
		end
	end
end

local accentTweenGeneration = 0
local function setAccentColor(newColor: Color3, customDuration: number?)
	local duration = customDuration or 0.35
	local oldAccent = THEME.primary
	if sameColor(oldAccent, newColor, 1) then return end

	activeSelectedAccent = newColor

	local oldHover = THEME.accentHover
	local oldKnob = THEME.toggleOnKnob

	local lum = 0.299 * newColor.R + 0.587 * newColor.G + 0.114 * newColor.B
	local targetKnob = lum > 0.75 and THEME.bgWindow or Color3.fromRGB(255, 255, 255)
	local targetHover = newColor:Lerp(Color3.fromRGB(255, 255, 255), 0.18)

	-- 1. Smoothly fade the custom cursor to the new accent color
	if updateCursorAccent then
		updateCursorAccent(newColor, duration)
	end

	-- 2. Smoothly tween all accent-bound UI elements across the interface
	repaintAccent(oldAccent, newColor, oldHover, targetHover, oldKnob, targetKnob, duration)

	-- 3. Interpolate THEME tokens over the duration so active reads transition smoothly
	accentTweenGeneration += 1
	local myGen = accentTweenGeneration

	task.spawn(function()
		local startTime = os.clock()
		while true do
			local elapsed = os.clock() - startTime
			local t = math.clamp(elapsed / duration, 0, 1)
			-- Smooth quad easing: t * (2 - t)
			local eased = t * (2 - t)

			local curAccent = oldAccent:Lerp(newColor, eased)
			THEME.warmAmber = curAccent
			THEME.brandTeal = curAccent
			THEME.primary = curAccent
			THEME.toggleOnTrack = curAccent
			THEME.accentHover = curAccent:Lerp(Color3.fromRGB(255, 255, 255), 0.18)
			THEME.toggleOnKnob = oldKnob:Lerp(targetKnob, eased)

			if t >= 1 or accentTweenGeneration ~= myGen then
				break
			end
			RunService.Heartbeat:Wait()
		end

		if accentTweenGeneration == myGen then
			THEME.warmAmber = newColor
			THEME.brandTeal = newColor
			THEME.primary = newColor
			THEME.toggleOnTrack = newColor
			THEME.accentHover = targetHover
			THEME.toggleOnKnob = targetKnob

			for _, fn in ipairs(accentListeners) do
				pcall(fn, newColor)
			end

			-- Final pass to ensure all elements are locked in
			repaintAccent(oldAccent, newColor, oldHover, targetHover, oldKnob, targetKnob, 0)
		end
	end)
end


