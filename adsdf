local function updateCategories()
	for _, c in ipairs(categories) do
		local data = categoryButtons[c.id]
		if data then
			local isActive = (c.id == selectedCategory)
			data.btn.BackgroundColor3 = isActive and THEME.panelRaised or THEME.bgWindow
			data.btn.BackgroundTransparency = isActive and 0.2 or 1
			data.indicator.Visible = isActive
			data.indicator.BackgroundColor3 = THEME.warmAmber
			data.icon.ImageColor3 = isActive and THEME.warmAmber or THEME.textMuted
			data.name.TextColor3 = isActive and THEME.textPrimary or THEME.textMuted
		end
	end
end
onAccentChange(function() updateCategories() end)


