UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		if scalerRoot.Visible then
			scalerRoot.Visible = false
			setInterfaceActive(false)
		else
			animateWindowIn()
		end
		return
	end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		local keyName = input.KeyCode.Name
		for _, m in ipairs(modules) do
			if m.bind == keyName then
				enabledState[m.name] = not enabledState[m.name]
				local fn = m.onToggle or m.callback
				if fn then safeCall(fn, enabledState[m.name]) end
				if refreshModules then refreshModules() end
			end
		end
	end
end)

