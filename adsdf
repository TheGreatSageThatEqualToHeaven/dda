local isCurrentlyLoading = false
local currentLoader: Instance? = nil

local function animateWindowIn()
	scalerRoot.Visible = true
	setInterfaceActive(true)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local targetScale = math.clamp(math.min((vp.X - 40) / 1200, (vp.Y - 40) / 740), 0.60, 1.15)
	
	local basePos = UDim2.fromScale(0.5, 0.5)
	scalerRoot.Position = UDim2.new(basePos.X.Scale, basePos.X.Offset, basePos.Y.Scale, basePos.Y.Offset + 18)
	uiScale.Scale = targetScale * 0.985
	
	TweenService:Create(scalerRoot, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = basePos
	}):Play()
	TweenService:Create(uiScale, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Scale = targetScale
	}):Play()
end

local function showLoadingScreen()
	if isCurrentlyLoading then return end
	isCurrentlyLoading = true

	if currentLoader then
		currentLoader:Destroy()
		currentLoader = nil
	end

	-- Hide the main interface during loading (1:1 with web preview)
	scalerRoot.Visible = false
	setInterfaceActive(false)
	if customCursorEnabled then
		cursorRoot.Visible = true
		UserInputService.MouseIconEnabled = false
		pcall(function()
			UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.ForceHide
		end)
	end

	local loaderRoot = Instance.new("Frame")
	loaderRoot.Name = "LoaderRoot"
	loaderRoot.AnchorPoint = Vector2.new(0.5, 0.5)
	loaderRoot.Position = UDim2.fromScale(0.5, 0.5)
	loaderRoot.Size = UDim2.fromOffset(900, 520)
	loaderRoot.BackgroundTransparency = 1
	loaderRoot.ZIndex = 100
	loaderRoot.Parent = gui
	currentLoader = loaderRoot

	local loaderScale = Instance.new("UIScale")
	loaderScale.Parent = loaderRoot

	local function updateLoaderScale()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local vp = cam.ViewportSize
		local scaleX = (vp.X - 40) / 940
		local scaleY = (vp.Y - 40) / 560
		loaderScale.Scale = math.clamp(math.min(scaleX, scaleY), 0.60, 1.15)
	end
	updateLoaderScale()
	local camConn = workspace.CurrentCamera and workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateLoaderScale)

	-- Drop shadow behind the loader modal
	local loaderShadow = Instance.new("ImageLabel")
	loaderShadow.Name = "LoaderShadow"
	loaderShadow.AnchorPoint = Vector2.new(0.5, 0.5)
	loaderShadow.Position = UDim2.fromScale(0.5, 0.5)
	loaderShadow.Size = UDim2.new(1, 140, 1, 140)
	loaderShadow.BackgroundTransparency = 1
	loaderShadow.Image = "rbxassetid://8992230677"
	loaderShadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
	loaderShadow.ImageTransparency = 0.35
	loaderShadow.ScaleType = Enum.ScaleType.Slice
	loaderShadow.SliceCenter = Rect.new(135, 135, 135, 135)
	loaderShadow.SliceScale = 1
	loaderShadow.ZIndex = 1
	loaderShadow.Parent = loaderRoot

	-- Modal window (.loader-window)
	local modal = Instance.new("Frame")
	modal.Name = "LoaderWindow"
	modal.Size = UDim2.fromScale(1, 1)
	modal.BackgroundColor3 = Color3.fromRGB(15, 15, 19)
