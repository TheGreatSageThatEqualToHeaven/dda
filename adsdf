	{ id = "Inventory", name = "Inventory", icon = "briefcase" },
	{ id = "Macros",    name = "Macros",    icon = "keyboard" },
	{ id = "Legit",     name = "Legit",     icon = "gamepad" },
}
local categories = (type(libraryEnvironment.VapeHubCategories) == "table" and libraryEnvironment.VapeHubCategories) or defaultCategories

local function safeCall(fn: any, ...)
	if type(fn) ~= "function" then return end
	local args = { ... }
	task.spawn(function()
		local ok, err = pcall(fn, table.unpack(args))
		if not ok then
			warn("[VapeHubUI] Callback error: " .. tostring(err))
		end
	end)
end

local enabledState: {[string]: boolean} = {}
for _, m in ipairs(modules) do
	local kind = m.kind or "toggle"
	if kind == "toggle" then
		enabledState[m.name] = (m.active == true or m.default == true)
	elseif kind == "slider" then
		if m.value == nil then
			m.value = m.default or m.min or 0
		end
	elseif kind == "dropdown" then
		if m.selected == nil then
			m.selected = m.default or (m.options and m.options[1])
		end
	elseif kind == "multidropdown" then
		if m.selected == nil then
			m.selected = m.default or {}
		end
	elseif kind == "textbox" then
		if m.value == nil then
			m.value = m.default or ""
		end
	end
end

--------------------------------------------------------------------------------
-- UNIVERSAL NAMED CONFIGURATION STORAGE
--------------------------------------------------------------------------------
local CONFIG_FOLDER = "UniversalSettings"
local CONFIG_EXTENSION = ".json"

local function configApisAvailable(): boolean
	return typeof(isfolder) == "function"
		and typeof(makefolder) == "function"
		and typeof(isfile) == "function"
		and typeof(readfile) == "function"
		and typeof(writefile) == "function"
		and typeof(listfiles) == "function"
end

local function ensureConfigFolder(): boolean
	if not configApisAvailable() then return false end
	local ok = pcall(function()
		if not isfolder(CONFIG_FOLDER) then
			makefolder(CONFIG_FOLDER)
		end
	end)
	return ok
end

local function sanitizeConfigName(name: string): string
	local cleaned = name:match("^%s*(.-)%s*$") or ""
	cleaned = cleaned:gsub("[^%w%-%_ ]", ""):gsub("%s+", "_")
	return cleaned:sub(1, 48)
end

local function configPath(name: string): string
	return CONFIG_FOLDER .. "/" .. sanitizeConfigName(name) .. CONFIG_EXTENSION
end

local memoryConfigs: {[string]: any} = {}

local function captureConfig(): {[string]: any}
	local data = {
		version = 1,
		controls = {},
	}
	for _, item in ipairs(modules) do
		local kind = item.kind or "toggle"
		local entry: {[string]: any} = { kind = kind }
		if kind == "toggle" then
			entry.value = (enabledState[item.name] == true)
		elseif kind == "slider" then
			entry.value = item.value or item.default or (item.min or 0)
		elseif kind == "textbox" then
			entry.value = item.value or item.default or ""
		elseif kind == "dropdown" then
			entry.value = item.selected or item.default or (item.options and item.options[1])
		elseif kind == "multidropdown" then
			entry.value = item.selected or item.default or {}
		else
			continue
		end
		entry.bind = item.bind
		data.controls[item.name] = entry
	end
	return data
end

local function saveNamedConfig(name: string): (boolean, string)
	local safeName = sanitizeConfigName(name)
	if safeName == "" then return false, "Enter a config name." end
	local payload = captureConfig()
	if configApisAvailable() then
		if not ensureConfigFolder() then return false, "File saving is unavailable in this environment." end
		local ok, err = pcall(function()
			writefile(configPath(safeName), HttpService:JSONEncode(payload))
		end)
		if ok then
			memoryConfigs[safeName] = payload
		end
		return ok, ok and ("Saved " .. safeName) or ("Save failed: " .. tostring(err))
	else
		memoryConfigs[safeName] = payload
		return true, "Saved " .. safeName
	end
end

local function loadNamedConfig(name: string): (boolean, string)
	local safeName = sanitizeConfigName(name)
	if safeName == "" then return false, "Select a config first." end
	local decoded: any = nil
	if configApisAvailable() then
		if not ensureConfigFolder() then return false, "File loading is unavailable in this environment." end
		local path = configPath(safeName)
		if not isfile(path) then return false, "Config not found." end
		local ok, result = pcall(function()
			return HttpService:JSONDecode(readfile(path))
		end)
		if not ok or type(result) ~= "table" or type(result.controls) ~= "table" then
			return false, "Config data is invalid."
		end
		decoded = result
	else
		if not memoryConfigs[safeName] then return false, "Config not found." end
		decoded = memoryConfigs[safeName]
	end

	for _, item in ipairs(modules) do
		local entry = decoded.controls[item.name]
		if type(entry) == "table" then
			local kind = item.kind or "toggle"
			if kind == "toggle" and type(entry.value) == "boolean" then
				enabledState[item.name] = entry.value
				local fn = item.onToggle or item.callback
				if fn then
					safeCall(fn, entry.value)
				end
			elseif kind == "slider" and type(entry.value) == "number" then
				local minVal = item.min or 0
				local maxVal = item.max or 100
				local step = item.step or 1
				local clamped = math.clamp(entry.value, minVal, maxVal)
				if step > 0 then
					clamped = math.round((clamped - minVal) / step) * step + minVal
					clamped = math.clamp(clamped, minVal, maxVal)
				end
				item.value = clamped
				local fn = item.onSlide or item.callback
				if fn then
					safeCall(fn, clamped)
				end
			elseif kind == "textbox" and type(entry.value) == "string" then
				item.value = entry.value
				local fn = item.onInput or item.callback
				if fn then
					safeCall(fn, entry.value)
				end
			elseif kind == "dropdown" and type(entry.value) == "string" then
				item.selected = entry.value
				local fn = item.onSelect or item.callback
				if fn then
					safeCall(fn, entry.value)
				end
			elseif kind == "multidropdown" and type(entry.value) == "table" then
				item.selected = entry.value
				local fn = item.onSelect or item.callback
				if fn then
					safeCall(fn, entry.value)
				end
			end
			if entry.bind == nil or type(entry.bind) == "string" then
				item.bind = entry.bind
			end
		end
	end
	return true, "Loaded " .. safeName
end

local function deleteNamedConfig(name: string): (boolean, string)
	local safeName = sanitizeConfigName(name)
	if safeName == "" then return false, "Select a config first." end
	if configApisAvailable() then
		if not ensureConfigFolder() or typeof(delfile) ~= "function" then
			return false, "File deletion is unavailable in this environment."
		end
		local path = configPath(safeName)
		if not isfile(path) then return false, "Config not found." end
		local ok, err = pcall(function() delfile(path) end)
		if ok then
			memoryConfigs[safeName] = nil
		end
		return ok, ok and ("Deleted " .. safeName) or ("Delete failed: " .. tostring(err))
	else
		if not memoryConfigs[safeName] then return false, "Config not found." end
		memoryConfigs[safeName] = nil
		return true, "Deleted " .. safeName
	end
end

local function listNamedConfigs(): {string}
	local names = {}
	if configApisAvailable() then
		if ensureConfigFolder() then
			local ok, files = pcall(function() return listfiles(CONFIG_FOLDER) end)
		if ok and type(files) == "table" then
			for _, path in ipairs(files) do
				local normalized = tostring(path):gsub("\\", "/")
				local fileName = normalized:match("([^/]+)%.json$")
				if fileName then table.insert(names, fileName) end
			end
		end
		end
	else
		for name, _ in pairs(memoryConfigs) do
			table.insert(names, name)
		end
	end
	table.sort(names, function(a, b) return a:lower() < b:lower() end)
	return names
end

