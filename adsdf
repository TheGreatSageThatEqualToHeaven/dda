			return
		end
		if not homePage.Visible then return end

		local mouse = UserInputService:GetMouseLocation()
		local pos, size = heroCard.AbsolutePosition, heroCard.AbsoluteSize
		local inside = size.X > 0 and mouse.X >= pos.X and mouse.X <= pos.X + size.X
			and mouse.Y >= pos.Y and mouse.Y <= pos.Y + size.Y

		local targetX, targetY, targetHover = 0, 0, 0
		if inside then
			targetX = math.clamp(((mouse.X - pos.X) / size.X) * 2 - 1, -1, 1)
			targetY = math.clamp(((mouse.Y - pos.Y) / size.Y) * 2 - 1, -1, 1)
			targetHover = 1
		end

		-- Frame-rate independent smoothing
		local a = 1 - math.exp(-dt * 10)
		tiltX += (targetX - tiltX) * a
		tiltY += (targetY - tiltY) * a
		tiltHover += (targetHover - tiltHover) * a

