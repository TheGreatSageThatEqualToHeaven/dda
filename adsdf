			checkIcon.AnchorPoint = Vector2.new(0.5, 0.5)
			checkIcon.Position = UDim2.fromScale(0.5, 0.5)
			checkIcon.Visible = isSelected
			checkIcon.ZIndex = 100003

			local optLbl = Instance.new("TextLabel")
			optLbl.AnchorPoint = Vector2.new(0, 0.5)
			optLbl.Position = UDim2.new(0, 32, 0.5, 0)
			optLbl.Size = UDim2.new(1, -36, 1, 0)
			optLbl.BackgroundTransparency = 1
			optLbl.Text = opt
