local customCursorEnabled = true

updateCursorAccent = function(targetAccent: Color3, duration: number?)
	local dur = duration or 0.35
	if dur > 0 then
		local tweenInfo = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(cursorMain, tweenInfo, { ImageColor3 = targetAccent }):Play()
		TweenService:Create(cursorGlow, tweenInfo, { ImageColor3 = targetAccent }):Play()
	else
		cursorMain.ImageColor3 = targetAccent
		cursorGlow.ImageColor3 = targetAccent
	end
end

local function setCustomCursorEnabled(enabled: boolean)
	customCursorEnabled = enabled
	if not enabled then
		cursorRoot.Visible = false
		UserInputService.MouseIconEnabled = true
		pcall(function()
			UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.None
		end)
	else
		if (isInterfaceOpen and scalerRoot and scalerRoot.Visible) or isCurrentlyLoading then
			cursorRoot.Visible = true
			UserInputService.MouseIconEnabled = false
			pcall(function()
				UserInputService.OverrideMouseIconBehavior = Enum.OverrideMouseIconBehavior.ForceHide
			end)
		end
	end
end

-- Cursor mouse movement tracking for immediate zero-latency feedback
UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement and cursorRoot.Visible then
		local mousePos = UserInputService:GetMouseLocation()
		cursorRoot.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
	end
end)

-- Tactile click press / release micro-animation
UserInputService.InputBegan:Connect(function(input, processed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and cursorRoot.Visible then
		TweenService:Create(cursorScale, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = 0.88
		}):Play()
	end
end)

UserInputService.InputEnded:Connect(function(input, processed)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and cursorRoot.Visible then
		TweenService:Create(cursorScale, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Scale = 1.0
		}):Play()
	end
end)

