	modal.ClipsDescendants = true
	modal.ZIndex = 2
	modal.Parent = loaderRoot
	addCorner(modal, 7)
	addStroke(modal, THEME.panelBorder, 1, 0)

	-- Dedicated clipping layer keeps both corner decorations inside the loader.
	-- This avoids rotated Frames escaping their rounded modal parent in Roblox.
	local decorClip = Instance.new("CanvasGroup")
	decorClip.Name = "DecorationClip"
	decorClip.Position = UDim2.fromOffset(1, 1)
	decorClip.Size = UDim2.new(1, -2, 1, -2)
	decorClip.BackgroundTransparency = 1
	decorClip.BorderSizePixel = 0
	decorClip.ClipsDescendants = true
	decorClip.GroupTransparency = 0
	decorClip.ZIndex = 2
	decorClip.Parent = modal
	addCorner(decorClip, 6)

	-- Two corner decorations (.loader-window::before and ::after)
	local decor1 = Instance.new("Frame")
	decor1.Size = UDim2.fromOffset(290, 290)
	decor1.Position = UDim2.fromOffset(-130, -110)
	decor1.Rotation = 25
	decor1.BackgroundColor3 = Color3.fromRGB(24, 25, 33)
	decor1.BackgroundTransparency = 0.65
	decor1.BorderSizePixel = 0
	decor1.ZIndex = 2
	decor1.Parent = decorClip
	addCorner(decor1, 120)

	local decor2 = Instance.new("Frame")
	decor2.Size = UDim2.fromOffset(290, 290)
	decor2.Position = UDim2.new(1, -160, 1, -180)
	decor2.Rotation = 25
