	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 6
	label.Parent = triggerBtn

	local chevron = createIcon(triggerBtn, "chevron-right", 12, THEME.textMuted)
	chevron.AnchorPoint = Vector2.new(1, 0.5)
	chevron.Position = UDim2.new(1, -8, 0.5, 0)
	chevron.Rotation = 90
	chevron.ZIndex = 6

	local isOpen = false

	local function openMenu()
		closeActiveDropdown()
		lastDropdownToggleTime = os.clock()
		isOpen = true
		chevron.Rotation = -90
		stroke.Color = THEME.primary

		local absPos = triggerBtn.AbsolutePosition
		local absSize = triggerBtn.AbsoluteSize
		local cam = workspace.CurrentCamera
		local vpHeight = (cam and cam.ViewportSize.Y) or 1080

		local itemHeight = 28
		local itemSpacing = 2
		local padY = 4
		local numOptions = #options
		local totalContentHeight = (padY * 2) + (numOptions * itemHeight) + (math.max(0, numOptions - 1) * itemSpacing)
		local maxHeight = 220
		local isScrollable = totalContentHeight > maxHeight
		local menuHeight = isScrollable and maxHeight or totalContentHeight
		local menuWidth = math.max(150, absSize.X)

		local posX = absPos.X
		local posY = absPos.Y + absSize.Y + 4
