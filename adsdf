			checkIndicator.Name = "CheckIndicator"
			checkIndicator.AnchorPoint = Vector2.new(0, 0.5)
			checkIndicator.Position = UDim2.new(0, 8, 0.5, 0)
			checkIndicator.Size = UDim2.fromOffset(16, 16)
