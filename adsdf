-- WINDOW DRAGGING SUPPORT (PC & Touch)
--------------------------------------------------------------------------------
local isDragging = false
local dragStart: Vector3? = nil
local startPos: UDim2? = nil

topbar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDragging = true
		dragStart = input.Position
		startPos = scalerRoot.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				isDragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		if dragStart and startPos then
			local delta = input.Position - dragStart
			local s = uiScale.Scale
			scalerRoot.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + (delta.X / s),
				startPos.Y.Scale,
				startPos.Y.Offset + (delta.Y / s)
			)
		end
	end
end)


--------------------------------------------------------------------------------
-- RESIZE DRAGGER (bottom-right corner - matching SimpleUI specification)
--------------------------------------------------------------------------------
local resizing = false
do
	local resizeDragger = Instance.new("ImageLabel")
	resizeDragger.Name = "resize"
	resizeDragger.Size = UDim2.new(0, 20, 0, 20)
	resizeDragger.Position = UDim2.new(1, -25, 1, -25)
	resizeDragger.BackgroundTransparency = 1
	resizeDragger.Image = "rbxassetid://6031091004" -- resize icon
	resizeDragger.ImageColor3 = THEME.textMuted
	resizeDragger.ImageTransparency = 0.5
	resizeDragger.ZIndex = 100
	resizeDragger.Parent = window

	local isResizing = false
	local startPosition, startSize, startRootPos = nil, nil, nil

	local function getInputPos(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			return Vector2.new(input.Position.X, input.Position.Y)
		else
			return UserInputService:GetMouseLocation()
		end
	end

	local minSize = Vector2.new(500, 320)

	resizeDragger.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isResizing = true
			resizing = true
			startPosition = getInputPos(input)
			startSize = Vector2.new(scalerRoot.Size.X.Offset, scalerRoot.Size.Y.Offset)
			startRootPos = scalerRoot.Position
			TweenService:Create(resizeDragger, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {Size = UDim2.new(0, 15, 0, 15)}):Play()
			TweenService:Create(resizeDragger, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {ImageColor3 = Color3.fromRGB(255, 255, 255), ImageTransparency = 0}):Play()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local mouse = getInputPos(input)
			if startPosition and mouse and startSize and startRootPos then
				local delta = mouse - startPosition
				local s = uiScale.Scale
				local deltaX = delta.X / s
				local deltaY = delta.Y / s
				local newWidth = math.max(minSize.X, startSize.X + deltaX)
				local newHeight = math.max(minSize.Y, startSize.Y + deltaY)
				local dW = newWidth - startSize.X
				local dH = newHeight - startSize.Y
				scalerRoot.Position = UDim2.new(
					startRootPos.X.Scale,
					startRootPos.X.Offset + (dW / 2),
					startRootPos.Y.Scale,
					startRootPos.Y.Offset + (dH / 2)
				)
				scalerRoot:TweenSize(
					UDim2.fromOffset(newWidth, newHeight),
					Enum.EasingDirection.Out,
					Enum.EasingStyle.Quint,
					0.4,
					true
				)
			end
		end
	end)

	resizeDragger.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isResizing = false
			resizing = false
			startPosition, startSize, startRootPos = nil, nil, nil
			TweenService:Create(resizeDragger, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {Size = UDim2.new(0, 20, 0, 20)}):Play()
			TweenService:Create(resizeDragger, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {ImageColor3 = THEME.textMuted, ImageTransparency = 0.5}):Play()
		end
	end)
end

