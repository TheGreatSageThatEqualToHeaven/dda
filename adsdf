				if opt ~= selected then
					TweenService:Create(optBtn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(28, 30, 36) }):Play()
				end
			end)
			optBtn.MouseLeave:Connect(function()
				if opt ~= selected then
					TweenService:Create(optBtn, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(22, 24, 29) }):Play()
				end
			end)

			optBtn.Activated:Connect(function()
				selected = opt
				label.Text = opt
				closeActiveDropdown()
				if config.callback then
					config.callback(opt)
				end
			end)
		end

		activeDropdownMenu = menu
		activeDropdownTrigger = triggerBtn
		activeDropdownCleanup = function()
			isOpen = false
			chevron.Rotation = 90
			stroke.Color = THEME.borderSubtle
		end
	end

	local function toggleDropdown()
		if isOpen then
			closeActiveDropdown()
		else
			openMenu()
		end
	end

	local lastToggle = 0
	triggerBtn.MouseButton1Down:Connect(function()
		lastToggle = os.clock()
		toggleDropdown()
	end)

	triggerBtn.Activated:Connect(function()
		if os.clock() - lastToggle < 0.15 then return end
		lastToggle = os.clock()
		toggleDropdown()
	end)

	return triggerBtn, {
		Set = function(opt: string)
			selected = opt
			label.Text = opt
		end,
		Get = function() return selected end,
	}
end

