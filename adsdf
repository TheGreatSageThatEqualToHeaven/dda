-- REFRESH MODULE LIST (68px row height, 1:1 with preview .module-row)
--------------------------------------------------------------------------------
refreshModules = function()
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local query = string.lower(searchInput.Text)

	for _, item in ipairs(modules) do
		local matchCat = (selectedCategory == "Favorites" and enabledState[item.name]) or (item.category == selectedCategory)
		local matchQuery = (query == "") or string.find(string.lower(item.name .. " " .. item.summary), query, 1, true)

		if matchCat and matchQuery then
			local isSelected = (selectedModule and selectedModule.name == item.name)
			local isEnabled = enabledState[item.name] == true

			local rowWrapper = Instance.new("Frame")
			rowWrapper.Name = "ModuleWrapper_" .. item.name
			rowWrapper.Size = UDim2.new(1, 0, 0, 68)
			rowWrapper.BackgroundTransparency = 1
			rowWrapper.Parent = list

			local row = Instance.new("TextButton")
			row.Name = "ModuleRow_" .. item.name
			row.AutoButtonColor = false
			row.Position = UDim2.fromOffset(0, 0)
			row.Size = UDim2.new(1, 0, 1, 0)
			row.BackgroundColor3 = isSelected and THEME.panelRaised or THEME.panelSoft
			row.BorderSizePixel = 0
			row.ClipsDescendants = false
			row.Text = ""
			row.Parent = rowWrapper
			addCorner(row, 6)
			addStroke(row, THEME.borderSubtle, 1, 0.4)

			-- Left Accent Bar: full height indicator, primary white when enabled/toggled, accent color when untoggled
			local accentPill = Instance.new("Frame")
			accentPill.Name = "AccentBar"
			accentPill.Position = UDim2.fromScale(0, 0)
			accentPill.Size = UDim2.new(0, 4, 1, 0)
			accentPill.BackgroundColor3 = isEnabled and THEME.primary or THEME.accent
			accentPill.BorderSizePixel = 0
			accentPill.ZIndex = 3
			accentPill.Visible = true
			accentPill.Parent = row
			addCorner(accentPill, 2)

			-- Title (15px bold #f0f2f4)
			local title = createLabel(row, item.name, 15, THEME.textPrimary, Enum.Font.GothamBold)
			title.Position = UDim2.fromOffset(25, 0)
			title.Size = UDim2.fromOffset(160, 68)
			title.TextTruncate = Enum.TextTruncate.AtEnd

			-- Summary (12px #787a80)
			local desc = createLabel(row, item.summary, 12, THEME.textMuted, Enum.Font.Gotham)
			desc.Position = UDim2.fromOffset(195, 0)
			desc.Size = UDim2.new(1, -380, 1, 0)
			desc.TextTruncate = Enum.TextTruncate.AtEnd

			-- Clickable Keybind Pill (kbd styling from CSS)
			local suppressRowOpen = false

			if item.kind == "button" then
				-- Action Button: perfectly centered vertically in the row, flush right
				local btnText = item.buttonText or "Action"
				local btn = Instance.new("TextButton")
				btn.Name = "RowButton_" .. item.name
				btn.AutoButtonColor = false
				btn.AnchorPoint = Vector2.new(1, 0.5)
				btn.Position = UDim2.new(1, -20, 0.5, 0)
				btn.Size = UDim2.fromOffset(88, 32)
				btn.BackgroundColor3 = THEME.primary
				btn.BorderSizePixel = 0
				btn.Text = btnText
				btn.TextColor3 = THEME.bgWindow
				btn.TextSize = 12
				btn.Font = Enum.Font.GothamBold
				btn.TextXAlignment = Enum.TextXAlignment.Center
				btn.TextYAlignment = Enum.TextYAlignment.Center
				btn.ZIndex = 5
				btn.Parent = row
				addCorner(btn, 6)

				btn.MouseEnter:Connect(function()
					TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = THEME.accentHover }):Play()
				end)
				btn.MouseLeave:Connect(function()
					TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = THEME.primary }):Play()
				end)
				btn.MouseButton1Down:Connect(function()
					suppressRowOpen = true
					TweenService:Create(btn, TweenInfo.new(0.08), { Size = UDim2.fromOffset(84, 30) }):Play()
				end)
				btn.MouseButton1Up:Connect(function()
					TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromOffset(88, 32) }):Play()
				end)
				btn.Activated:Connect(function()
					suppressRowOpen = true
					task.delay(0.2, function() suppressRowOpen = false end)
					local fn = item.onClick or item.callback
					if fn then
						safeCall(fn)
					else
						print("[" .. item.name .. "] Button clicked")
					end
				end)

			elseif item.kind == "textbox" then
				-- Input TextBox: perfectly centered vertically in the row, flush right
				local inputFrame = Instance.new("Frame")
				inputFrame.Name = "RowInput_" .. item.name
				inputFrame.AnchorPoint = Vector2.new(1, 0.5)
				inputFrame.Position = UDim2.new(1, -20, 0.5, 0)
				inputFrame.Size = UDim2.fromOffset(140, 32)
				inputFrame.BackgroundColor3 = THEME.panelRaised
				inputFrame.BorderSizePixel = 0
				inputFrame.ZIndex = 5
				inputFrame.Parent = row
				addCorner(inputFrame, 6)
				local inputStroke = addStroke(inputFrame, THEME.borderSubtle, 1, 0.4)

				local tb = Instance.new("TextBox")
				tb.Name = "Input"
				tb.AnchorPoint = Vector2.new(0.5, 0.5)
				tb.Position = UDim2.fromScale(0.5, 0.5)
				tb.Size = UDim2.new(1, -16, 1, -8)
				tb.BackgroundTransparency = 1
				tb.Text = item.value or ""
				tb.PlaceholderText = item.placeholder or "Type info..."
				tb.PlaceholderColor3 = THEME.textMuted
				tb.TextColor3 = THEME.textPrimary
				tb.TextSize = 11
				tb.Font = Enum.Font.Gotham
				tb.TextXAlignment = Enum.TextXAlignment.Left
				tb.TextYAlignment = Enum.TextYAlignment.Center
				tb.ClearTextOnFocus = false
				tb.ClipsDescendants = true
				tb.ZIndex = 6
				tb.Parent = inputFrame

				tb.Focused:Connect(function()
					suppressRowOpen = true
					TweenService:Create(inputStroke, TweenInfo.new(0.2), { Color = THEME.primary, Transparency = 0.1 }):Play()
					TweenService:Create(inputFrame, TweenInfo.new(0.2), { BackgroundColor3 = THEME.accent }):Play()
				end)

				tb.FocusLost:Connect(function(enterPressed)
					task.delay(0.2, function() suppressRowOpen = false end)
					TweenService:Create(inputStroke, TweenInfo.new(0.2), { Color = THEME.borderSubtle, Transparency = 0.4 }):Play()
					TweenService:Create(inputFrame, TweenInfo.new(0.2), { BackgroundColor3 = THEME.panelRaised }):Play()
					item.value = tb.Text
					local fn = item.onInput or item.callback
					if fn then
						safeCall(fn, tb.Text)
					else
						print("[" .. item.name .. "] Input set: " .. tb.Text)
					end
				end)

			elseif item.kind == "slider" then
				-- Inline Slider: perfectly centered vertically in the row, flush right
				accentPill.BackgroundColor3 = THEME.brandTeal
				local sliderHolder = Instance.new("Frame")
				sliderHolder.Name = "RowSlider_" .. item.name
				sliderHolder.AnchorPoint = Vector2.new(1, 0.5)
				sliderHolder.Position = UDim2.new(1, -20, 0.5, 0)
				sliderHolder.Size = UDim2.fromOffset(170, 32)
				sliderHolder.BackgroundTransparency = 1
				sliderHolder.ZIndex = 5
				sliderHolder.Parent = row

				createSlider(sliderHolder, {
					name = item.name,
					min = item.min or 0,
					max = item.max or 100,
					default = item.value or item.default or 50,
					step = item.step or 1,
					unit = item.unit or "",
					size = UDim2.fromScale(1, 1),
					callback = function(val)
						item.value = val
						local fn = item.onSlide or item.callback
						if fn then
							safeCall(fn, val)
						end
					end
				})

			elseif item.kind == "dropdown" then
				-- Inline Dropdown: perfectly centered vertically in the row, flush right
				accentPill.BackgroundColor3 = THEME.primary
				local dropHolder = Instance.new("Frame")
				dropHolder.Name = "RowDropdown_" .. item.name
				dropHolder.AnchorPoint = Vector2.new(1, 0.5)
				dropHolder.Position = UDim2.new(1, -20, 0.5, 0)
				dropHolder.Size = UDim2.fromOffset(150, 32)
				dropHolder.BackgroundTransparency = 1
				dropHolder.ZIndex = 5
				dropHolder.Parent = row

				createDropdown(dropHolder, {
					name = item.name,
					options = item.options or {"Option 1", "Option 2", "Option 3"},
					default = item.selected or item.default or (item.options and item.options[1]),
					size = UDim2.fromScale(1, 1),
					callback = function(val)
						item.selected = val
						local fn = item.onSelect or item.callback
						if fn then
							safeCall(fn, val)
						end
					end
				})

			elseif item.kind == "multidropdown" then
				-- Inline Multi Dropdown: perfectly centered vertically in the row, flush right
				accentPill.BackgroundColor3 = THEME.primary
				local multiHolder = Instance.new("Frame")
				multiHolder.Name = "RowMultiDropdown_" .. item.name
				multiHolder.AnchorPoint = Vector2.new(1, 0.5)
				multiHolder.Position = UDim2.new(1, -20, 0.5, 0)
				multiHolder.Size = UDim2.fromOffset(150, 32)
				multiHolder.BackgroundTransparency = 1
				multiHolder.ZIndex = 5
				multiHolder.Parent = row

				createMultiDropdown(multiHolder, {
					name = item.name,
					options = item.options or {"Option A", "Option B", "Option C"},
					default = (type(item.selected) == "table" and item.selected) or (type(item.default) == "table" and item.default) or nil,
					size = UDim2.fromScale(1, 1),
					callback = function(vals)
						item.selected = vals
						local fn = item.onSelect or item.callback
						if fn then
							safeCall(fn, vals)
						end
					end
				})

			elseif item.kind == "info" then
				-- Info row: subtle accent and perfectly centered badge
				accentPill.BackgroundColor3 = THEME.brandTeal
				local infoBadge = Instance.new("Frame")
				infoBadge.AnchorPoint = Vector2.new(1, 0.5)
				infoBadge.Position = UDim2.new(1, -20, 0.5, 0)
				infoBadge.Size = UDim2.fromOffset(72, 28)
				infoBadge.BackgroundColor3 = THEME.panelRaised
				infoBadge.BorderSizePixel = 0
				infoBadge.ZIndex = 5
				infoBadge.Parent = row
				addCorner(infoBadge, 5)
				addStroke(infoBadge, THEME.borderSubtle, 1, 0.4)

				local badgeIcon = createIcon(infoBadge, "info", 14, THEME.brandTeal)
				badgeIcon.AnchorPoint = Vector2.new(0, 0.5)
				badgeIcon.Position = UDim2.new(0, 8, 0.5, 0)

				local badgeText = Instance.new("TextLabel")
				badgeText.Name = "BadgeText"
				badgeText.AnchorPoint = Vector2.new(0, 0.5)
				badgeText.Position = UDim2.new(0, 26, 0.5, 0)
				badgeText.Size = UDim2.new(1, -30, 1, 0)
				badgeText.BackgroundTransparency = 1
				badgeText.Text = "INFO"
				badgeText.TextSize = 11
				badgeText.TextColor3 = THEME.brandTeal
				badgeText.Font = Enum.Font.GothamBold
				badgeText.TextXAlignment = Enum.TextXAlignment.Center
				badgeText.TextYAlignment = Enum.TextYAlignment.Center
				badgeText.Parent = infoBadge

			else
				-- Standard Toggle Row (clean toggle, no keybind unless explicitly set)
				local hasBind = (item.bind ~= nil and item.bind ~= "")

				-- 3-Dots Settings Button (opens drawer only for toggles that have settings)
				local hasSettings = (item.hasSettings ~= false)
				local toggleOffset = hasSettings and -56 or -20

				if hasSettings then
					local moreBtn = Instance.new("TextButton")
					moreBtn.Name = "MoreButton_" .. item.name
					moreBtn.AutoButtonColor = false
					moreBtn.AnchorPoint = Vector2.new(1, 0.5)
					moreBtn.Position = UDim2.new(1, -16, 0.5, 0)
					moreBtn.Size = UDim2.fromOffset(28, 28)
					moreBtn.BackgroundColor3 = THEME.accent
					moreBtn.BorderSizePixel = 0
					moreBtn.Text = ""
					moreBtn.ZIndex = 5
					moreBtn.Parent = row
					addCorner(moreBtn, 4)
					addStroke(moreBtn, THEME.borderSubtle, 1, 0.3)

					local dotsLabel = Instance.new("TextLabel")
					dotsLabel.AnchorPoint = Vector2.new(0.5, 0.5)
					dotsLabel.Position = UDim2.fromScale(0.5, 0.5)
					dotsLabel.Size = UDim2.fromScale(1, 1)
					dotsLabel.BackgroundTransparency = 1
					dotsLabel.Text = "•••"
					dotsLabel.TextColor3 = THEME.textMuted
					dotsLabel.TextSize = 13
					dotsLabel.Font = Enum.Font.GothamBold
					dotsLabel.ZIndex = 6
					dotsLabel.Parent = moreBtn

					moreBtn.MouseEnter:Connect(function()
						dotsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
						moreBtn.BackgroundColor3 = THEME.panelRaised
					end)
					moreBtn.MouseLeave:Connect(function()
						dotsLabel.TextColor3 = THEME.textMuted
						moreBtn.BackgroundColor3 = THEME.accent
					end)
					moreBtn.Activated:Connect(function()
						suppressRowOpen = true
						openDrawer(item)
					end)
				end

				-- Toggle switch perfectly centered vertically at 0.5
				local toggleHolder = Instance.new("Frame")
				toggleHolder.AnchorPoint = Vector2.new(1, 0.5)
				toggleHolder.Position = UDim2.new(1, toggleOffset, 0.5, 0)
				toggleHolder.Size = UDim2.fromOffset(38, 22)
				toggleHolder.BackgroundTransparency = 1
				toggleHolder.Parent = row

				local toggleTrack = createToggle(toggleHolder, isEnabled, function(state)
					enabledState[item.name] = state
					accentPill.BackgroundColor3 = state and THEME.primary or THEME.accent
					local fn = item.onToggle or item.callback
					if fn then safeCall(fn, state) end
				end)
				toggleTrack.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						suppressRowOpen = true
						task.delay(0.15, function()
							suppressRowOpen = false
						end)
					end
				end)

				-- Only show Keybind button if this toggle item explicitly has a keybind
				if hasBind then
					local kbdOffset = hasSettings and -104 or -68
					local kbdBtn = Instance.new("TextButton")
					kbdBtn.Name = "KeybindButton_" .. item.name
					kbdBtn.AutoButtonColor = false
					kbdBtn.AnchorPoint = Vector2.new(1, 0.5)
					kbdBtn.Position = UDim2.new(1, kbdOffset, 0.5, 0)
					kbdBtn.Size = UDim2.fromOffset(56, 24)
					kbdBtn.BackgroundColor3 = THEME.accent
					kbdBtn.BorderSizePixel = 0
					kbdBtn.Text = ""
					kbdBtn.ZIndex = 5
					kbdBtn.Parent = row
					addCorner(kbdBtn, 4)
					local kbdStroke = addStroke(kbdBtn, THEME.border, 1, 0.2)

					local kbdText = Instance.new("TextLabel")
					kbdText.AnchorPoint = Vector2.new(0.5, 0.5)
					kbdText.Position = UDim2.fromScale(0.5, 0.5)
					kbdText.Size = UDim2.fromScale(1, 1)
					kbdText.BackgroundTransparency = 1
					kbdText.Text = item.bind
					kbdText.TextSize = 11
					kbdText.TextColor3 = THEME.secondaryFg
					kbdText.Font = Enum.Font.GothamMedium
					kbdText.TextXAlignment = Enum.TextXAlignment.Center
					kbdText.TextYAlignment = Enum.TextYAlignment.Center
					kbdText.Parent = kbdBtn

					local isBinding = false
					kbdBtn.Activated:Connect(function()
						if isBinding then return end
						isBinding = true
						kbdText.Text = "..."
						kbdText.TextColor3 = THEME.brandTeal
						kbdStroke.Color = THEME.brandTeal

						local conn: RBXScriptConnection? = nil
						conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
							if input.UserInputType == Enum.UserInputType.Keyboard then
								if conn then conn:Disconnect(); conn = nil end
								isBinding = false
								kbdStroke.Color = THEME.border

								if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
									item.bind = nil
									kbdBtn.Visible = false
								elseif input.KeyCode == Enum.KeyCode.Escape then
									kbdText.Text = item.bind or ""
									kbdText.TextColor3 = THEME.secondaryFg
								else
									local newKey = input.KeyCode.Name
									item.bind = newKey
									kbdText.Text = newKey
									kbdText.TextColor3 = THEME.textPrimary
								end
							end
						end)
					end)
				end
			end

			-- Module rows only open settings when the 3-dots button is clicked
			row.Activated:Connect(function()
				-- Row click does not automatically open the drawer anymore
			end)

			-- Smooth Hover (translateX(2px) + background to #15161a 1:1 with CSS)
			local hoverIn: Tween? = nil
			local hoverOut: Tween? = nil

			row.MouseEnter:Connect(function()
				if hoverOut then hoverOut:Cancel() end
				if not (selectedModule and selectedModule.name == item.name) then
					hoverIn = TweenService:Create(row, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						BackgroundColor3 = THEME.panelRaised,
						Position = UDim2.fromOffset(2, 0),
					})
					hoverIn:Play()
				end
			end)
			row.MouseLeave:Connect(function()
				if hoverIn then hoverIn:Cancel() end
				if not (selectedModule and selectedModule.name == item.name) then
					hoverOut = TweenService:Create(row, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						BackgroundColor3 = THEME.panelSoft,
						Position = UDim2.fromOffset(0, 0),
					})
					hoverOut:Play()
				end
			end)
		end
