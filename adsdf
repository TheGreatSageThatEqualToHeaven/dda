	fill.BackgroundColor3 = THEME.brandTeal
	fill.BorderSizePixel = 0
	fill.ZIndex = 3
	fill.Parent = track
	addCorner(fill, 3)

	-- Loading status label ("INITIALIZING INTERFACE")
	local status = createLabel(modal, "INITIALIZING INTERFACE", 9, THEME.textMuted, Enum.Font.GothamMedium)
	status.AnchorPoint = Vector2.new(0.5, 0.5)
	status.Position = UDim2.fromScale(0.5, 0.64)
	status.Size = UDim2.fromOffset(260, 18)
	status.TextXAlignment = Enum.TextXAlignment.Center
	status.ZIndex = 3

	local function dismissAndEnter()
		if not isCurrentlyLoading then return end
		isCurrentlyLoading = false
		if camConn then camConn:Disconnect() end

		TweenService:Create(loaderScale, TweenInfo.new(0.20, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = loaderScale.Scale * 0.96
		}):Play()

		task.delay(0.20, function()
			if loaderRoot and loaderRoot.Parent then
				loaderRoot:Destroy()
			end
			currentLoader = nil
			animateWindowIn()
		end)
	end

	-- Close button (loader-close X)
	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "LoaderClose"
	closeBtn.Size = UDim2.fromOffset(30, 30)
	closeBtn.Position = UDim2.new(1, -44, 0, 14)
