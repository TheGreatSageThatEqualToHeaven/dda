			title.Position = UDim2.fromOffset(25, 0)
			title.Size = UDim2.fromOffset(180, 68)
			title.TextTruncate = Enum.TextTruncate.AtEnd

			-- Summary subtitle (12px #787a80)
			local desc = createLabel(row, isSelected and "Active configuration profile" or "Custom configuration profile", 12, THEME.textMuted, Enum.Font.Gotham)
			desc.Position = UDim2.fromOffset(210, 0)
			desc.Size = UDim2.new(1, -380, 1, 0)
