				if not isSelected then
					TweenService:Create(row, TweenInfo.new(0.2), { BackgroundColor3 = THEME.panelSoft }):Play()
				end
			end)

			row.Activated:Connect(function()
				if suppressRowSelect then return end
				activeConfigName = name
