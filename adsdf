local function styleSmallButton(button: TextButton, text: string, width: number, rightOffset: number, destructive: boolean?)
	button.AnchorPoint = Vector2.new(1, 0.5)
	button.Position = UDim2.new(1, rightOffset, 0.5, 0)
	button.Size = UDim2.fromOffset(width, 32)
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.Text = ""

	local bg = Instance.new("Frame")
	bg.Name = "ButtonBg"
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	bg.BorderSizePixel = 0
	bg.ZIndex = button.ZIndex
	bg.Parent = button
	addCorner(bg, 6)

	local label = Instance.new("TextLabel")
	label.Name = "ButtonLabel"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextSize = 12
	label.Font = Enum.Font.GothamBold
	label.ZIndex = button.ZIndex + 1
	label.Parent = button

	if destructive then
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		local grad = addGradient(bg, Color3.fromRGB(245, 68, 68), Color3.fromRGB(180, 24, 24), 90)
		local stroke = addStroke(bg, Color3.fromRGB(255, 120, 120), 1, 0.15)

		button.MouseEnter:Connect(function()
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 95, 95)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(210, 32, 32)),
			})
			TweenService:Create(stroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(255, 170, 170), Transparency = 0 }):Play()
		end)
		button.MouseLeave:Connect(function()
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(245, 68, 68)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 24, 24)),
			})
			TweenService:Create(stroke, TweenInfo.new(0.15), { Color = Color3.fromRGB(255, 120, 120), Transparency = 0.15 }):Play()
		end)
	else
		label.TextColor3 = THEME.bgWindow
		bg.BackgroundColor3 = THEME.primary
		local grad = addGradient(bg, Color3.fromRGB(255, 255, 255), Color3.fromRGB(224, 228, 235), 90)
		local stroke = addStroke(bg, THEME.primary, 1, 0.2)

		button.MouseEnter:Connect(function()
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(240, 243, 248)),
			})
			TweenService:Create(stroke, TweenInfo.new(0.15), { Transparency = 0 }):Play()
		end)
		button.MouseLeave:Connect(function()
			grad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(224, 228, 235)),
			})
			TweenService:Create(stroke, TweenInfo.new(0.15), { Transparency = 0.2 }):Play()
		end)
	end
end

