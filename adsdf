		tiltGlare.BackgroundTransparency = 1 - 0.35 * tiltHover
		tiltGlareGrad.Offset = Vector2.new(tiltX * 0.25, tiltY * 0.25)
		tiltGlareGrad.Rotation = 25 + tiltX * 12

