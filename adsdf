--------------------------------------------------------------------------------
local function createToggle(parent: Instance, initial: boolean, onToggle: (boolean) -> ())
	local track = Instance.new("TextButton")
	track.Name = "ToggleTrack"
	track.AutoButtonColor = false
	track.Size = UDim2.fromOffset(36, 22)
	track.BorderSizePixel = 0
	track.Text = ""
	track.Parent = parent
	addCorner(track, 11)

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.fromOffset(14, 14)
	knob.BorderSizePixel = 0
	knob.Parent = track
	addCorner(knob, 7)

	local state = initial

	local function refresh(animate: boolean)
		local targetColor = state and THEME.toggleOnTrack or THEME.toggleOffTrack
		local targetKnobColor = state and THEME.toggleOnKnob or THEME.toggleOffKnob
		local targetPos = state and UDim2.fromOffset(25, 11) or UDim2.fromOffset(11, 11)

		if animate then
			TweenService:Create(track, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = targetColor }):Play()
			TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundColor3 = targetKnobColor, Position = targetPos }):Play()
		else
			track.BackgroundColor3 = targetColor
			knob.BackgroundColor3 = targetKnobColor
			knob.Position = targetPos
		end
	end

	refresh(false)

	track.Activated:Connect(function()
		state = not state
		refresh(true)
		if onToggle then onToggle(state) end
	end)

	return track, function(newState: boolean)
		state = newState
		refresh(true)
	end
end

